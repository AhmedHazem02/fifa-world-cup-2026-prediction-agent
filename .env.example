# Live AI provider (OpenAI-compatible API)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Hybrid blend: 0.3 = 30% AI + 70% statistical model
AI_BLEND_WEIGHT=0.3

# Force mock AI even when API key is set (offline/testing)
# AI_USE_MOCK=true

# Request timeout in milliseconds
AI_TIMEOUT_MS=30000
